rules_version = '2';

// Samadhan talks to Firestore directly from the browser. There is no server in
// front of these collections any more, so this file is the ONLY thing standing
// between a hostile client and the data. Every rule below is load-bearing.
//
// Baseline note: the tRPC API this replaced exposed almost every mutation as a
// `publicProcedure`, i.e. unauthenticated callers could already invoke them.
// Requiring sign-in here is therefore a tightening, not a loosening.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // "admin" is a Firebase Auth custom claim, settable only by the Admin SDK
    // (scripts/grant-admin.mjs). It is never read from a Firestore document,
    // because users can write their own document.
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function userEmail() {
      return isSignedIn() ? request.auth.token.email : "";
    }

    function changed(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // True only if every changed field is inside the given whitelist — the
    // inverse of `changed()`. Used to let a caller touch a narrow, known-safe
    // set of fields on a document they don't otherwise own outright.
    function onlyFieldsChanged(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // An institution/industry account's own linked organization, looked up
    // from its own `users/{uid}` profile. Only trustworthy because the
    // `users/{uid}` rule below refuses to let a caller set `organizationId`
    // to anything other than an org it actually owns (see `isOrgOwner`).
    function callerOrgId() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('organizationId', null)
        : null;
    }

    function orgDoc(organizationId) {
      return get(/databases/$(database)/documents/organizations/$('record-' + string(organizationId)));
    }

    // The one strong, tamper-resistant check for "does this signed-in user
    // control this specific organization" — reads `organizations.ownerUid`
    // directly rather than trusting anything the caller wrote about
    // themselves. `organizations`' own rules already guarantee `ownerUid`
    // can only be set at creation (to the creator) and never changed except
    // by an admin, so this is safe to build authorization on.
    function isOrgOwner(organizationId) {
      return isSignedIn() && organizationId != null && orgDoc(organizationId).data.ownerUid == request.auth.uid;
    }

    function challengeDoc(challengeId) {
      return get(/databases/$(database)/documents/challenges/$('record-' + string(challengeId)));
    }

    function isChallengeOwner(challengeId) {
      return isSignedIn() && challengeDoc(challengeId).data.citizenEmail == userEmail();
    }

    function projectDoc(projectId) {
      return get(/databases/$(database)/documents/projects/$('record-' + string(projectId)));
    }

    // Is the caller the institution that owns this project?
    function isProjectOrgOwner(projectId) {
      return isOrgOwner(projectDoc(projectId).data.organizationId);
    }

    // Is the caller the citizen who filed the challenge this project answers?
    // (This is what lets USP-07's citizen-confirms-resolution flow write to a
    // project/closeout it doesn't itself "own" the way an institution does.)
    function isProjectChallengeOwner(projectId) {
      return isChallengeOwner(projectDoc(projectId).data.challengeId);
    }

    // Is the caller's own organization the institution holding a real,
    // *accepted* assignment for this specific challenge? Assignment document
    // ids are deterministic (`assign-{challengeId}-{organizationId}`, see
    // `assignmentDocId()` in db.ts) specifically so this can be checked with
    // a single `exists()`/`get()` instead of trusting a client-supplied
    // organizationId or scanning the collection. This is what makes the
    // institution-authorized `challenges.status` transition below safe: only
    // the institution actually assigned to *this* challenge — not any
    // institution-linked account — can flip it.
    function isAcceptedAssignee(challengeId) {
      return isSignedIn() && callerOrgId() != null
        && exists(/databases/$(database)/documents/assignments/$('assign-' + string(challengeId) + '-' + string(callerOrgId())))
        && get(/databases/$(database)/documents/assignments/$('assign-' + string(challengeId) + '-' + string(callerOrgId()))).data.status == 'accepted';
    }

    // Notifications are always a side effect of a *specific* legitimate
    // workflow action, sent to a *specific* third party — never something
    // the caller writes for themselves except `type: "self"`. This checks
    // both halves for every type db.ts actually sends: (a) is the caller
    // really the actor who could trigger this kind of notification, using
    // the exact same relationship helpers the underlying workflow writes are
    // already authorized against, and (b) does the claimed `recipientEmail`
    // actually resolve to the real party for that relationship — not an
    // arbitrary address the caller typed in. `type` plus whichever reference
    // id(s) it needs are the only new fields added for this; a write missing
    // the field its claimed type requires fails closed (an undefined-field
    // read errors that branch to `false`, not a crash — verified against the
    // emulator). `admin_notice` is intentionally not a branch here: it is
    // only ever created by db.ts after an admin-gated write already
    // succeeded elsewhere, and admin already bypasses this whole function
    // via `allow create` below.
    function isAuthorizedNotification() {
      let d = request.resource.data;
      let orgId = d.get('organizationId', null);
      let challengeId = d.get('challengeId', null);
      let projectId = d.get('projectId', null);
      return
        (d.type == 'self' && d.recipientEmail == userEmail())
        || (d.type == 'admin_org_notice' && isAdmin() && orgId != null
            && d.recipientEmail == orgDoc(orgId).data.contactEmail)
        || (d.type == 'assignment_status' && challengeId != null && orgId != null
            && isOrgOwner(orgId)
            && exists(/databases/$(database)/documents/assignments/$('assign-' + string(challengeId) + '-' + string(orgId)))
            && d.recipientEmail == challengeDoc(challengeId).data.citizenEmail)
        || (d.type == 'project_to_citizen' && projectId != null && challengeId != null
            && isProjectOrgOwner(projectId)
            && projectDoc(projectId).data.challengeId == challengeId
            && d.recipientEmail == challengeDoc(challengeId).data.citizenEmail)
        || (d.type == 'citizen_to_institution' && projectId != null
            && isProjectChallengeOwner(projectId)
            && d.recipientEmail == orgDoc(projectDoc(projectId).data.organizationId).data.contactEmail)
        || (d.type == 'industry_interest' && projectId != null
            && d.recipientEmail == orgDoc(projectDoc(projectId).data.organizationId).data.contactEmail);
    }

    // ------------------------------------------------------------------ users
    match /users/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);

      // A user may only write their own profile, and may never store the
      // "admin" role — elevation happens exclusively through the custom claim.
      // Likewise, `organizationId` may only be set to an organization the
      // caller actually owns (per `organizations.ownerUid`) — without this,
      // a user could self-link to any institution's id and inherit every
      // institution-scoped write permission below (assignments, projects,
      // milestones, documents, activities, closeouts, org members).
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && (!('role' in request.resource.data)
            || request.resource.data.role in ['citizen', 'institution', 'industry'])
        && (!('memberRole' in request.resource.data)
            || request.resource.data.memberRole in ['admin', 'faculty', 'student'])
        && (!changed(['organizationId'])
            || request.resource.data.organizationId == null
            || isOrgOwner(request.resource.data.organizationId)
            || ((resource == null || resource.data.get('organizationId', null) == null)
                && 'memberRole' in request.resource.data
                && request.resource.data.memberRole in ['faculty', 'student']));

      allow delete: if false;
    }

    // ---------------------------------------------------------- organizations
    // Publicly readable by design: the UI frames organizations as open civic
    // records under public review.
    match /organizations/{docId} {
      allow read: if true;

      // Applicants always start pending/active; only an admin may create an
      // organization in any other state.
      allow create: if isAdmin() || (isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.verificationStatus == 'pending'
        && request.resource.data.standing == 'active');

      // Owners may edit their own profile details, but never their own
      // verification status, standing, or ownership.
      allow update: if isAdmin() || (isSignedIn()
        && resource.data.ownerUid == request.auth.uid
        && !changed(['verificationStatus', 'verificationNotes', 'standing',
                     'standingNotes', 'standingUpdatedAt', 'ownerUid']));

      allow delete: if isAdmin();
    }

    // ------------------------------------------------------------- challenges
    // Read stays fully public (the delivery pipeline is a deliberately public
    // ledger — see the project architecture notes). Write is scoped per
    // field: the reporting citizen owns their own report's content and the
    // citizen-confirmation
    // fields; anyone signed in may cast/retract an upvote (upvoteCount only);
    // and specifically the institution holding a real, accepted assignment
    // for *this* challenge (`isAcceptedAssignee`, not just any
    // institution-linked account) may flip the workflow `status` field, which
    // is what `createProject()` needs to stamp `status: "in_progress"` once
    // that institution's assignment has actually been accepted. Admin
    // retains full access.
    match /challenges/{docId} {
      // USP-10: visibilityTier controls public read scope.
      // "public" (default) and "restricted" stay world-readable (restricted's
      // privacy is a client-rendering convention: the UI omits the byline/pin
      // but Firestore itself remains readable — this is documented as a known
      // limitation, see USP-10 doc). "confidential" is Firestore-enforced:
      // only the owner (citizenEmail) and admins can read the document.
      // Old records without visibilityTier are treated as "public" (field defaults
      // to "public" for new records; old records missing it pass the first branch
      // because missing == null != "confidential").
      allow read: if isAdmin()
        || resource.data.get('visibilityTier', 'public') != 'confidential'
        || resource.data.citizenEmail == userEmail();

      // Self: citizenEmail must be the caller's own email (existing path).
      // Assisted: any signed-in user may file on behalf of a beneficiary as
      // long as the report is tagged assisted, carries the submitter's uid,
      // has a beneficiary name, and does NOT claim the beneficiary's email as
      // the submitter's own. Old clients without these fields still hit the
      // first branch and are unaffected.
      allow create: if isSignedIn() && (
        request.resource.data.citizenEmail == userEmail()
        || (
          request.resource.data.get('submittedVia', 'self') == 'assisted'
          && request.resource.data.submittedByUid == request.auth.uid
          && request.resource.data.beneficiaryName is string
          && request.resource.data.beneficiaryName.size() > 0
          && (!('citizenEmail' in request.resource.data) || request.resource.data.citizenEmail == userEmail() || request.resource.data.citizenEmail == "")
        )
      );

      allow update: if isAdmin()
        || (isSignedIn() && resource.data.citizenEmail == userEmail()
            && onlyFieldsChanged(['title', 'description', 'domain', 'district',
                                   'status', 'resolutionSummary', 'updatedAt']))
        || (isSignedIn() && onlyFieldsChanged(['upvoteCount', 'updatedAt']))
        || (isSignedIn() && isAcceptedAssignee(resource.data.id)
            && onlyFieldsChanged(['status', 'updatedAt']));

      allow delete: if isAdmin() || (isSignedIn() && resource.data.citizenEmail == userEmail());
    }

    // ----------------------------------------------- public workflow records
    // Readable by anyone (the delivery pipeline is public). Writes are scoped
    // to the specific institution/citizen the record actually belongs to,
    // rather than any signed-in user — see the helper functions above.

    match /assignments/{docId} {
      allow read: if true;

      // Covers both `assignChallenge` (admin) and `enrollChallenge`
      // (self-enrollment by a verified institution for its own org id).
      allow create: if isAdmin()
        || (isSignedIn() && isOrgOwner(request.resource.data.organizationId)
            && request.resource.data.status == 'pending');

      // Covers `updateAssignment` (accept/decline) — the owning institution
      // may only flip `status`, never reassign the assignment to another
      // org or challenge.
      allow update: if isAdmin()
        || (isSignedIn() && isOrgOwner(resource.data.organizationId)
            && onlyFieldsChanged(['status', 'updatedAt']));

      allow delete: if isAdmin();
    }

    match /projects/{docId} {
      allow read: if true;

      // `createProject()` — only the institution that owns the assignment.
      allow create: if isAdmin() || (isSignedIn() && isOrgOwner(request.resource.data.organizationId));

      // The owning institution may edit its own project freely, but never
      // reassign it to another organization/challenge. The citizen who filed
      // the underlying challenge may — and only may — write the specific
      // fields USP-07's citizen-confirmation flow needs
      // (`CitizenCloseoutConfirm.tsx` setting status/progress on confirm, or
      // status/riskSummary on dispute).
      allow update: if isAdmin()
        || (isSignedIn() && isOrgOwner(resource.data.organizationId)
            && !changed(['organizationId', 'challengeId']))
        || (isSignedIn() && isChallengeOwner(resource.data.challengeId)
            && onlyFieldsChanged(['status', 'progress', 'riskSummary', 'updatedAt']));

      allow delete: if isAdmin();
    }

    match /projectMilestones/{docId} {
      allow read: if true;
      allow create: if isAdmin() || (isSignedIn() && isProjectOrgOwner(request.resource.data.projectId));
      allow update: if isAdmin()
        || (isSignedIn() && isProjectOrgOwner(resource.data.projectId) && !changed(['projectId']));
      allow delete: if isAdmin();
    }

    match /projectDocuments/{docId} {
      allow read: if true;
      allow create: if isAdmin() || (isSignedIn() && isProjectOrgOwner(request.resource.data.projectId));
      // No page in the app currently updates or deletes an uploaded document
      // record — admin-only is a safe default that breaks nothing today.
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /projectActivities/{docId} {
      allow read: if true;
      allow create: if isAdmin() || (isSignedIn() && isProjectOrgOwner(request.resource.data.projectId));
      // No page edits/deletes an activity entry once logged — it's an
      // append-only log by design (USP-03 hash chain), admin-only default.
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /projectCloseouts/{docId} {
      allow read: if true;

      // `submitCloseout()` — only the institution delivering the project.
      allow create: if isAdmin() || (isSignedIn() && isProjectOrgOwner(request.resource.data.projectId));

      // `updateProjectCloseout()` — only the citizen who filed the underlying
      // challenge may confirm/dispute, and only those two fields.
      // USP-09: assisted reports keep the same fields but the check is the
      // beneficiary's delegated OTP, not the submitter's email. For the demo
      // this is enforced client-side (hash check in CitizenCloseoutConfirm)
      // and the rule here simply allows any signed-in user to write those
      // fields when the underlying challenge is `submittedVia == "assisted"`.
      // Production would mint a short-lived custom token via a Worker and
      // check it here instead of this permissive branch.
      allow update: if isAdmin()
        || (isSignedIn() && isProjectChallengeOwner(resource.data.projectId)
            && onlyFieldsChanged(['citizenConfirmation', 'citizenNotes', 'updatedAt']))
        || (isSignedIn() && challengeDoc(projectDoc(resource.data.projectId).data.challengeId).data.submittedVia == "assisted"
            && onlyFieldsChanged(['citizenConfirmation', 'citizenNotes', 'updatedAt']));

      allow delete: if isAdmin();
    }

    match /challengeEvidence/{docId} {
      allow read: if true;
      // `uploadChallengeEvidence()` — only the citizen who owns the challenge
      // the evidence is attached to (the challenge document always exists
      // first: `submitChallenge()` creates it, then evidence is uploaded
      // against the resulting id).
      allow create: if isAdmin() || (isSignedIn() && isChallengeOwner(request.resource.data.challengeId));
      allow update: if isAdmin();
      // `deleteChallenge()` removes a citizen's own evidence before deleting
      // the challenge itself, in that order — the challenge doc (and its
      // citizenEmail) still exists when this rule evaluates.
      allow delete: if isAdmin() || (isSignedIn() && isChallengeOwner(resource.data.challengeId));
    }

    match /industryInterests/{docId} {
      allow read: if true;
      // `submitIndustryInterest()` — `organizationId` is optional on this
      // collection; if the caller supplies one, it must be their own.
      allow create: if isAdmin()
        || (isSignedIn() && (!('organizationId' in request.resource.data)
                              || request.resource.data.organizationId == null
                              || isOrgOwner(request.resource.data.organizationId)));
      // No page currently calls `updateIndustryInterest()` — scoped to the
      // submitting organization or the institution owning the referenced
      // project, so if/when it is wired up it can't be used to edit a
      // commitment that isn't the caller's own.
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.organizationId != null && isOrgOwner(resource.data.organizationId))
        || (isSignedIn() && isProjectOrgOwner(resource.data.projectId));
      allow delete: if isAdmin();
    }

    match /organizationMembers/{docId} {
      allow read: if true;
      // `addOrganizationMember()` / `updateOrganizationMember()` /
      // `deleteOrganizationMember()` — only that institution's own roster,
      // including the USP-06 `awardCredits()` write to `creditsEarned`.
      allow create: if isAdmin() || (isSignedIn() && isOrgOwner(request.resource.data.organizationId));
      allow update: if isAdmin()
        || (isSignedIn() && isOrgOwner(resource.data.organizationId) && !changed(['organizationId']));
      allow delete: if isAdmin() || (isSignedIn() && isOrgOwner(resource.data.organizationId));
    }

    // Invite must be able to validate before the user is linked to the org —
    // the token itself is the capability, so any signed-in user who knows it
    // may read it. Creation/deletion stays owner-only, and update is limited
    // to marking the invite as consumed.
    function isSameOrgForProject(projectId) {
      return isSignedIn() && callerOrgId() != null
        && callerOrgId() == projectDoc(projectId).data.organizationId;
    }

    match /projectForumPosts/{docId} {
      allow read: if true;
      allow create: if isSignedIn() && isSameOrgForProject(request.resource.data.projectId);
      allow update: if isAdmin() || (isSignedIn() && resource.data.authorUid == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.authorUid == request.auth.uid);
    }

    // Invite link must be verifiable *before* the user is signed in or linked
    // to the org — the token itself is the capability. Public get/list is
    // safe here because the token is an unguessable random string; without
    // it an attacker cannot discover invites. Write stays owner/member-only.
    match /organizationInvites/{docId} {
      allow read: if true;
      allow create: if isSignedIn() && (isOrgOwner(request.resource.data.organizationId) || callerOrgId() == request.resource.data.organizationId);
      allow update: if isSignedIn()
        && resource.data.usedByUid == null
        && request.resource.data.usedByUid == request.auth.uid
        && onlyFieldsChanged(['usedByUid', 'updatedAt']);
      allow delete: if isSignedIn() && (isOrgOwner(resource.data.organizationId) || callerOrgId() == resource.data.organizationId);
    }

    // ----------------------------------------------- ledger anchors (USP-03)
    // Publicly readable for hash-chain verification. Only admins may anchor
    // (write), because the anchor certifies the chain state — a non-admin
    // anchor would be meaningless.
    match /ledgerAnchors/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ------------------------------------------------------ private per-user
    // These two are NOT publicly readable. Because rules are evaluated per
    // document, a listing query only succeeds if it already filters on the
    // owning field — which is why lib/db.ts queries them with `where(...)`
    // instead of reading the whole collection.
    match /notifications/{docId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.recipientEmail == userEmail());
      // Every notification now carries a `type` plus the challenge/project/
      // organization reference id(s) that type needs (see `db.ts`'s
      // `createNotification()`), which `isAuthorizedNotification()` checks
      // against the real, stored relationship — not just against
      // well-typed-but-unverified fields. This closes the previous gap where
      // any signed-in user could write an arbitrary notification (forged
      // sender, arbitrary recipient) — see the project architecture notes
      // for the incident this fixed.
      allow create: if isAdmin()
        || (isSignedIn()
            && request.resource.data.recipientEmail is string
            && request.resource.data.title is string
            && request.resource.data.title.size() <= 255
            && request.resource.data.body is string
            && request.resource.data.body.size() <= 2000
            && (!('href' in request.resource.data) || request.resource.data.href is string)
            && isAuthorizedNotification());
      allow update, delete: if isAdmin();
    }

    match /challengeSupports/{docId} {
      // `get` (including inside a transaction) must also allow probing a
      // deterministic support-doc id that doesn't exist yet — `upvoteChallenge()`
      // does exactly this to atomically check-for-duplicate before creating it.
      // `resource` is `null` for a nonexistent doc, so `resource.data...` alone
      // would throw and deny the read outright, before the doc is ever created.
      allow get: if isAdmin() || (isSignedIn() && (resource == null || resource.data.supporterEmail == userEmail()));
      // `list` always targets existing docs matched by a `where(...)` clause
      // (see lib/db.ts), so `resource` is never null here — same condition as before.
      allow list: if isAdmin() || (isSignedIn() && resource.data.supporterEmail == userEmail());
      allow create: if isSignedIn() && request.resource.data.supporterEmail == userEmail();
      allow update: if false;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.supporterEmail == userEmail());
    }

    // Anything not matched above stays denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

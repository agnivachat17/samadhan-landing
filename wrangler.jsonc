{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "samadhan-landing",
  "compatibility_date": "2026-08-25",
  "assets": {
    "directory": "./dist/public",
    // wouter handles routing in the browser, so unknown paths must fall through
    // to index.html rather than 404.
    "not_found_handling": "single-page-application",
  },
  "observability": {
    "enabled": true,
  },
}
